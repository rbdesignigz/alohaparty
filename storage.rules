rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permite lectura pública de imágenes de productos y escritura a usuarios autenticados (admin)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
